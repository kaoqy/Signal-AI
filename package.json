{
  "name": "cloudflare-ai-model-availability-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-test.mjs",
    "visual-smoke": "node scripts/visual-smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply model-monitor --local",
    "db:migrate:remote": "wrangler d1 migrations apply model-monitor --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@eslint/js": "10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  }
}
